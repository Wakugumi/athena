{
  "compilerOptions": {
    "target": "ES2021",
    "lib": [
      "ES2021"
    ],
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "outDir": "./dist",
    "paths": {
      "@athena/*": [
        "libs/*/src"
      ],
      "src/*": [
        "apps/athena-server/src/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "dist"
  ]
}
